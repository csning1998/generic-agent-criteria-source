#!/usr/bin/env bash

# Terraform operations in this layer MUST authenticate through the credential-distributor Vault Proxy of the repository owner.
# A failed vault-proxy-env exits here because direnv runs .envrc without errexit and eval of an empty string returns 0.
proxy_env="$(vault-proxy-env credential-distributor-generic-agent-criteria-source)" || exit 1
eval "${proxy_env}"
unset proxy_env
export TF_HTTP_ADDRESS="${GITLAB_TERRAFORM_STATE_BASE:?vault-proxy-env exported no GITLAB_TERRAFORM_STATE_BASE}/administration-gitlab-project"
export TF_HTTP_LOCK_ADDRESS="${TF_HTTP_ADDRESS}/lock"
export TF_HTTP_UNLOCK_ADDRESS="${TF_HTTP_LOCK_ADDRESS}"
export TF_VAR_gitlab_url="${GITLAB_URL:?vault-proxy-env exported no GITLAB_URL}"
export TF_VAR_gitlab_top_level_group_path="${GITLAB_TOP_LEVEL_GROUP_PATH:?vault-proxy-env exported no GITLAB_TOP_LEVEL_GROUP_PATH}"
