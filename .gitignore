# Allow-list. ~/.grok is a product home directory. Only user-authored trees are tracked.
# Runtime state, credentials, binaries, vendor bundles, session logs, and the official user-guide stay untracked.

/*
!/.gitignore
!/.gitattributes
!/.gitlab-ci.yml
!/.githooks
!/pyproject.toml
!/pyrightconfig.json
!/uv.lock
!/tests/
!/tests/**
!/.mdlrc
!/.yamllint.yml
!/README.md
!/.gitlab/
!/.gitlab/**
!/.vscode/
!/.vscode/**
!/commitlint.config.cjs

# User skills consumed by Grok.
!/skills/
!/skills/**

# Owner subagent roles (effort bands). Bundled roles stay untracked.
!/roles/
!/roles/**
!/rules/
!/rules/**
!/hooks/
!/hooks/**
hooks/state

# Markdown linters, coding standards, and the skill-system contract.
!/docs/
/docs/*
!/docs/.markdownlint.json
!/docs/.mdlrc
!/docs/coding-standards/
!/docs/coding-standards/**
!/docs/skill-system/
!/docs/skill-system/**

# User memory notes that skills and sessions read.
!/memory/
!/memory/**

# Tracked template only. Live ~/.grok/config.toml is rewritten by the TUI
# (reasoning effort, theme, privacy ack) and stays covered by /*.
!/config.example.toml
!/config/
!/config/contexts.example.toml

# Personal workstation SELinux playbooks. Not consumed by Grok at runtime.
!/ansible/
!/ansible/**

# GitLab project provision layer. Local .terraform and state files stay ignored.
!/terraform/
!/terraform/**
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/*.tfplan
**/crash.log
**/crash.*.log

__pycache__/
*.egg-info/
terraform/layers/meta-gitlab-project/tls/bastion-ca.pem
