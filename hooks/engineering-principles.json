{
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "bin/engineering-principles.py",
                        "timeout": 15
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "bin/engineering-principles.py",
                        "timeout": 15
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Write|Edit|Bash|Read|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bin/engineering-principles.py",
                        "timeout": 15
                    }
                ]
            },
            {
                "matcher": "search_replace|read_file|run_terminal_command",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bin/engineering-principles.py",
                        "timeout": 15
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Read|read_file|Write|Edit|Bash|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bin/engineering-principles.py",
                        "timeout": 15
                    }
                ]
            },
            {
                "matcher": "search_replace|run_terminal_command",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bin/engineering-principles.py",
                        "timeout": 15
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "bin/engineering-principles.py",
                        "timeout": 15
                    }
                ]
            }
        ],
        "SubagentStop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "bin/engineering-principles.py",
                        "timeout": 15
                    }
                ]
            }
        ]
    }
}
